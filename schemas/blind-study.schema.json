{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audience-mirror.dev/schemas/blind-study.schema.json",
  "title": "Audience Mirror Blind Study Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "experiment_id", "generated_at", "purpose", "design", "variants", "measures", "pre_registered_metrics", "governance", "limitations"],
  "properties": {
    "schema_version": {"const": "audience-mirror.blind-study/v0.1"},
    "study_id": {"type": "string", "pattern": "^study-[a-f0-9]{12}$"},
    "experiment_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "purpose": {"const": "exploratory_human_convergence"},
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reception_context", "outcome_blinded", "condition_mapping_blinded_to_participants", "participant_slots", "variant_count", "counterbalanced", "randomization_seed", "statistical_representativeness_claimed", "calibration_level_target"],
      "properties": {
        "reception_context": {"const": "independent_blind"},
        "outcome_blinded": {"const": true},
        "condition_mapping_blinded_to_participants": {"const": true},
        "participant_slots": {"type": "integer", "minimum": 2},
        "variant_count": {"enum": [1, 2]},
        "counterbalanced": {"type": "boolean"},
        "randomization_seed": {"type": "integer"},
        "statistical_representativeness_claimed": {"const": false},
        "calibration_level_target": {"const": "u1_exploratory_only"}
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["opaque_label", "asset_id", "variant_id", "content_hash", "timeline_id", "timeline_hash", "duration_ms"],
        "properties": {
          "opaque_label": {"enum": ["cut-x", "cut-y"]},
          "asset_id": {"type": "string", "minLength": 1},
          "variant_id": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "timeline_id": {"type": "string", "minLength": 1},
          "timeline_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "duration_ms": {"type": "integer", "minimum": 1}
        }
      }
    },
    "measures": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instrument_type", "metric_ids"],
        "properties": {
          "instrument_type": {"enum": ["timestamp_issue", "post_view_scale", "interview_code", "ab_choice"]},
          "metric_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "pre_registered_metrics": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participant_identity_collected_in_packet", "consent_record_required_before_exposure", "human_anchor_schema", "withdrawal_invalidates_analysis", "researcher_key_must_be_access_separated"],
      "properties": {
        "participant_identity_collected_in_packet": {"const": false},
        "consent_record_required_before_exposure": {"const": true},
        "human_anchor_schema": {"const": "audience-mirror.human-anchor/v0.1"},
        "withdrawal_invalidates_analysis": {"const": true},
        "researcher_key_must_be_access_separated": {"const": true}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
