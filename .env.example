# No key is required for local video decoding or the deterministic demo.
AUDIENCE_MIRROR_MODEL_PROVIDER=deterministic-fixture
AUDIENCE_MIRROR_MAX_COST_USD=0.25

# Optional native full-video analysis. Remote processing is still denied until the
# experiment explicitly enables it; confidential/restricted assets are rejected.
GEMINI_API_KEY=

# The model-driven sequential runtime uses the locally authenticated Claude Code CLI.
# Do not store its OAuth token or credentials in this repository.
